# Copy to .env for local development. In production set these as the host's
# environment variables instead -- .env is gitignored and never deployed.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Signs sessions AND derives the key that encrypts secrets stored in the
# database (app/secret_crypto.py). Changing it logs everyone out and makes
# previously encrypted settings unreadable. Generate once, then keep it:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Postgres in production. If this is empty the app falls back to a local SQLite
# file and prints a warning -- on a hosted platform that means an empty
# database that is wiped on every deploy.
#   local dev:   sqlite:///digital_club_01.db
#   production:  postgresql://user:password@host:5432/dbname
DATABASE_URL=

# ---------------------------------------------------------------------------
# Initial admin account (created on first start if absent)
# ---------------------------------------------------------------------------
ADMIN_EMAIL=admin@digitalclub.kiut.ac.tz
# Set this before the first deploy. Without it the account is created with a
# default development password that is published in this repository.
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# Number of gunicorn workers. Leave unset to size from the container's CPU
# quota (capped at 8); set it explicitly on a small instance.
GUNICORN_WORKERS=3

# Leave SERVER_NAME unset. When set, Flask returns 404 for any request whose
# Host header does not match, which breaks platform healthchecks and generated
# domains. URLs in emails are derived from the request instead.
# SERVER_NAME=
PREFERRED_URL_SCHEME=https

# ---------------------------------------------------------------------------
# Time zone
# ---------------------------------------------------------------------------
APP_TIMEZONE=Africa/Nairobi
APP_UTC_OFFSET_HOURS=3

# ---------------------------------------------------------------------------
# Optional integrations (features degrade quietly when unset)
# ---------------------------------------------------------------------------

# Cloudflare Turnstile on the auth forms
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Beem SMS, used for member notifications
BEEM_API_KEY=
BEEM_SECRET_KEY=

# Email (password resets, notifications)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
FROM_EMAIL=
